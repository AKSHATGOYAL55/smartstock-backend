# Server
NODE_ENV=development
PORT=4000

# Database (local Docker Compose MongoDB; swap for your Atlas URI in production)
MONGODB_URI=mongodb://localhost:27017/smartstock

# Redis (local Docker Compose Redis; swap for your Redis Cloud URI in production)
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# (Added as we build each feature — Cloudinary, email, Sentry, etc.)
